{
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "lint": "biome check ./",
    "format": "biome check --write ./",
    "generate-json-schema": "typescript-json-schema --strictNullChecks true --noExtraProps true --required src/rules.ts RuleStringPatterns > ./schema.json",
    "release:verify": "bun ./scripts/verify-release-version.mjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@octokit/action": "^8.0.4",
    "ajv": "^8.20.0",
    "mustache": "^4.2.0"
  },
  "name": "happy-commit",
  "version": "0.10.0",
  "main": "dist/index.js",
  "repository": "git@github.com:kitsuyui/happy-commit.git",
  "author": "kitsuyui <kitsuyui@kitsuyui.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@swc/core": "^1.15.11",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.4",
    "rollup-plugin-license": "^3.6.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.68.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "bun@1.3.11"
}
